# === Dependencies ===
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# === Build output ===
dist/
build/
out/
.next/
.turbo/
*.tsbuildinfo
next-env.d.ts
.vercel

# === Test / lint artifacts ===
test-results/
playwright-report/
coverage/

# === Logs ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
SeatAtTheTable/.codex-dev-server.log
SeatAtTheTable/.codex-dev-server.err.log

# === OS / editor cruft ===
.DS_Store
Thumbs.db

# === Secrets & environment config — NEVER commit real values ===
# Keep only .env.example (or similarly named templates) tracked.
.env
.env.*
!.env.example
!.env.*.example

# === Credentials, keys, certificates ===
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
.npmrc
.netrc
credentials.json
*serviceAccountKey.json
*service-account*.json

# === Local databases ===
*.sqlite
*.sqlite3
*.db
prisma/dev.db

# === Local AI tool config (machine-specific, may contain local paths/permissions) ===
.claude/settings.local.json
.claude/*.local.json
.codex/
.agents/

# === Scratch / temp ===
.tmp-assets/
__pycache__/
